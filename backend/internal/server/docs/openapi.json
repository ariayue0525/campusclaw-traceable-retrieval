{
  "openapi":"3.0.3",
  "info":{"title":"CampusClaw 教学 AI 平台 API","version":"5.0.0","description":"JWT Bearer；班级与角色由服务端实时读取。私有资源的他班、他人和不存在 ID 均返回 404。SSE 采用 POST fetch + ReadableStream。"},
  "servers":[{"url":"/week04","description":"教学平台入口"},{"url":"/","description":"根路径 API"}],
  "security":[{"bearerAuth":[]}],
  "components":{
    "securitySchemes":{"bearerAuth":{"type":"http","scheme":"bearer","bearerFormat":"JWT"}},
    "parameters":{"id":{"name":"id","in":"path","required":true,"schema":{"type":"integer","minimum":1}},"query":{"name":"q","in":"query","schema":{"type":"string"}}},
    "responses":{"BadRequest":{"description":"请求格式或参数错误","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"Unauthorized":{"description":"缺少或过期的 Bearer JWT","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"Forbidden":{"description":"角色无权限","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"NotFound":{"description":"资源不存在、属于他班或他人","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"Unavailable":{"description":"数据库、检索或对话网关不可用","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}},
    "schemas":{
      "Error":{"type":"object","required":["error"],"properties":{"error":{"type":"string"}}},
      "User":{"type":"object","properties":{"id":{"type":"integer"},"username":{"type":"string"},"displayName":{"type":"string"},"role":{"type":"string","enum":["teacher","student"]},"classId":{"type":"integer"},"className":{"type":"string"}}},
      "TokenPair":{"type":"object","properties":{"token_type":{"type":"string"},"access_token":{"type":"string"},"expires_in":{"type":"integer"},"refresh_token":{"type":"string"},"user":{"$ref":"#/components/schemas/User"}}},
      "Material":{"type":"object","properties":{"id":{"type":"integer"},"classId":{"type":"integer"},"title":{"type":"string"},"originalName":{"type":"string"},"mediaType":{"type":"string"},"sizeBytes":{"type":"integer"},"content":{"type":"string"},"createdAt":{"type":"string","format":"date-time"}}},
      "Agent":{"type":"object","properties":{"id":{"type":"integer"},"class_id":{"type":"integer"},"name":{"type":"string","maxLength":64},"prompt":{"type":"string","maxLength":2000},"prompt_template_id":{"type":"integer","nullable":true},"enabled":{"type":"boolean"},"skill_ids":{"type":"array","items":{"type":"integer"}},"material_ids":{"type":"array","items":{"type":"integer"}},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}}},
      "AgentInput":{"type":"object","required":["name","enabled","skill_ids","material_ids"],"properties":{"name":{"type":"string","maxLength":64},"prompt":{"type":"string","maxLength":2000},"prompt_template_id":{"type":"integer","nullable":true},"enabled":{"type":"boolean"},"skill_ids":{"type":"array","items":{"type":"integer"}},"material_ids":{"type":"array","items":{"type":"integer"}}}},
      "Skill":{"type":"object","properties":{"id":{"type":"integer"},"class_id":{"type":"integer"},"name":{"type":"string"},"trigger_text":{"type":"string"},"subject_text":{"type":"string"},"description":{"type":"string"},"tools":{"type":"array","items":{"type":"string"}},"source_text":{"type":"string"},"enabled":{"type":"boolean"}}},
      "Template":{"type":"object","properties":{"id":{"type":"integer"},"class_id":{"type":"integer"},"name":{"type":"string"},"content":{"type":"string"},"enabled":{"type":"boolean"}}},
      "Conversation":{"type":"object","properties":{"id":{"type":"integer"},"class_id":{"type":"integer"},"user_id":{"type":"integer"},"agent_id":{"type":"integer"},"title":{"type":"string"},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}}},
      "Message":{"type":"object","properties":{"id":{"type":"integer"},"conversation_id":{"type":"integer"},"role":{"type":"string","enum":["user","assistant"]},"content":{"type":"string"},"citations":{"type":"array","items":{"$ref":"#/components/schemas/Citation"}},"skill_name":{"type":"string"},"created_at":{"type":"string","format":"date-time"}}},
      "Citation":{"type":"object","properties":{"chunk_id":{"type":"integer"},"material_id":{"type":"integer"},"material_title":{"type":"string"},"chunk_index":{"type":"integer"},"start_offset":{"type":"integer"},"end_offset":{"type":"integer"},"snippet":{"type":"string"}}},
      "SearchInput":{"type":"object","required":["q"],"properties":{"q":{"type":"string"},"mode":{"type":"string","enum":["keyword","vector","hybrid"]},"limit":{"type":"integer"},"offset":{"type":"integer"}}},
      "SearchResult":{"type":"object","properties":{"q":{"type":"string"},"mode":{"type":"string"},"status":{"type":"string"},"hits":{"type":"array","items":{"type":"object"}},"total":{"type":"integer"},"collection":{"type":"string"}}},
      "MCPServer":{"type":"object","properties":{"id":{"type":"integer"},"class_id":{"type":"integer"},"name":{"type":"string"},"base_url":{"type":"string"},"has_token":{"type":"boolean"},"connected":{"type":"boolean"}}},
      "MCPTool":{"type":"object","properties":{"id":{"type":"integer"},"server_id":{"type":"integer"},"name":{"type":"string"},"description":{"type":"string"},"input_schema":{"type":"object"}}}
    }
  },
