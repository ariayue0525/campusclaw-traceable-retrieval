    "/api/conversations/{id}/messages/stream":{"post":{"tags":["会话"],"summary":"真实流式多轮问答；浏览器用 fetch 读取 SSE","description":"事件顺序：meta（技能与引用）、delta（本次新增文本，可多次）、done（助手消息持久化后的 ID）或 error（流开始后的故障）。","parameters":[{"$ref":"#/components/parameters/id"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["content"],"properties":{"content":{"type":"string","maxLength":4000}}}}}},"responses":{"200":{"description":"SSE 事件流","content":{"text/event-stream":{"schema":{"type":"string","example":"event: meta\\ndata: {\\\"citations\\\":[]}\\n\\nevent: delta\\ndata: {\\\"text\\\":\\\"你好\\\"}\\n\\nevent: done\\ndata: {\\\"message_id\\\":12}\\n\\n"}}}},"400":{"$ref":"#/components/responses/BadRequest"},"404":{"$ref":"#/components/responses/NotFound"},"503":{"$ref":"#/components/responses/Unavailable"}}}},
