WEB_PORT=8080
MYSQL_DATABASE=campusclaw
MYSQL_USER=campusclaw
MYSQL_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
SESSION_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
# access token（JWT）有效期；refresh token 有效期（须不短于 TOKEN_TTL）
TOKEN_TTL=30m
REFRESH_TTL=168h
UPLOAD_MAX_BYTES=2097152
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW=1m
SEED_TEACHER_PASSWORD=CHANGE_ME_TEACHER_PASSWORD
SEED_STUDENT_A_PASSWORD=CHANGE_ME_STUDENT_A_PASSWORD
SEED_STUDENT_B_PASSWORD=CHANGE_ME_STUDENT_B_PASSWORD

# ---- 第四次课：可追溯知识库检索 ----
# 向量库由 compose 内部网络提供，不对外暴露端口。
QDRANT_COLLECTION=campusclaw_chunks
# local = 内置确定性嵌入器（无需密钥，开箱即用）；gateway = 课程网关的 OpenAI 兼容嵌入接口。
EMBED_PROVIDER=local
# 使用 gateway 时须与模型维度一致（text-embedding-3-small 为 1536）；local 默认 256。
EMBED_DIM=256
LLM_GATEWAY_BASE_URL=https://ai-gateway.devops.hello1023.com/v1
# 留空即回退到 local 嵌入；填入后自动切换到 gateway。请勿提交真实密钥。
LLM_GATEWAY_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
LLM_GATEWAY_TIMEOUT=20s
# 向量检索的最低相似度，低于阈值不进入结果，也不会据此作答。
# 留空即由后端按嵌入实现选择：gateway 为 0.35，local 为 0.15。
VECTOR_MIN_SCORE=
VECTOR_CANDIDATES=50
RRF_K=60
SEARCH_LIMIT=10
SEARCH_MAX_LIMIT=50
ASK_TOP_K=4
SNIPPET_MAX_CHARS=240
VECTOR_PREVIEW_DIMS=8
INDEX_MAX_CHUNKS=400
